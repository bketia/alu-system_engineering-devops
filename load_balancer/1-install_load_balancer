#!/usr/bin/env bash
# Installs HAProxy and load balances traffic to web-01 and web-02 using roundrobin
apt-get -y update
apt-get -y install haproxy
echo "ENABLED=1" >> /etc/default/haproxy
cat > /etc/haproxy/haproxy.cfg << 'CONF'
global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server 7108-web-01 18.175.244.187:80 check
    server 7108-web-02 3.8.123.78:80 check
CONF
if haproxy -v | grep -qE 'version (1\.9|[2-9])'; then
    sed -i '/^    daemon$/a\    h1-case-adjust x-served-by X-Served-By' /etc/haproxy/haproxy.cfg
    sed -i '/^    default_backend http_back$/i\    option h1-case-adjust-bogus-client' /etc/haproxy/haproxy.cfg
fi
service haproxy restart
